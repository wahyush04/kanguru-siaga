# Salin file ini menjadi keystore.properties di root project (jangan pernah di-commit ke Git)
# Path storeFile bisa absolut (mis. C:/Users/.../upload-keystore.jks) atau relatif terhadap root/app.
storeFile=upload-keystore.jks
storePassword=GANTI_PASSWORD_KEYSTORE
keyAlias=kangurusiaga
keyPassword=GANTI_PASSWORD_KEY

