rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             'admin' in request.auth.token &&
             request.auth.token.admin == true;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Koleksi Profil Onboarding Bayi (Backward Compatibility)
    match /baby_onboarding_profiles/{profileId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 2. Koleksi Rekam Medis Pengguna (1 Dokumen = 1 User)
    match /baby_records/{userDocId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();

      // Subkoleksi: baby_data (Profil Bayi & Ibu)
      match /baby_data/{docId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create: if request.resource.data.createdAtServer == request.time;
        allow update: if request.resource.data.createdAtServer == resource.data.createdAtServer;
        allow delete: if isAdmin();
      }

      // Subkoleksi: pmk_daily_records (Rekam Harian PMK)
      match /pmk_daily_records/{recordId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create, update: if true;
        allow delete: if isAdmin();
      }

      // Subkoleksi: screenings (Skrining Wajib & Tambahan)
      match /screenings/{docId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create, update: if true;
        allow delete: if isAdmin();
      }

      // Subkoleksi: growth_measurements (Pertumbuhan Terstruktur)
      match /growth_measurements/{measurementId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create, update: if true;
        allow delete: if isAdmin();
      }

      // Subkoleksi legacy: pmk_sessions (Kompatibilitas)
      match /pmk_sessions/{sessionId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create, update: if true;
        allow delete: if isAdmin();
      }
    }
  }
}