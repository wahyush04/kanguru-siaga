rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// 1. Collection: baby_onboarding_profiles (Backward Compatibility)
//    Document ID: Auto-generated Firestore ID
//    Fields:
//      - babyName: string (required, 1..100 characters) - Nama bayi saat onboarding
//      - birthDateEpochMillis: number (required, > 0, <= request.time.toMillis()) - Epoch milidetik lahir
//      - birthDateFormatted: string (required, <= 50 characters) - Tanggal lahir terformat
//      - gestationalAgeWeeks: number (required, 20..50) - Usia gestasi bayi dalam minggu saat lahir
//      - birthWeightGram: number (required, 100..10000) - Berat badan lahir dalam gram
//      - currentWeightGram: number (required, 100..20000) - Berat badan saat onboarding dalam gram
//      - birthLengthCm: number (required, 0.0..100.0) - Panjang badan lahir dalam cm
//      - currentLengthCm: number (required, 0.0..100.0) - Panjang badan saat onboarding dalam cm
//      - birthHeadCircumferenceCm: number (required, 0.0..80.0) - Lingkar kepala lahir dalam cm
//      - currentHeadCircumferenceCm: number (required, 0.0..80.0) - Lingkar kepala saat onboarding dalam cm
//      - gender: string (required, allowed: ['LAKI_LAKI', 'PEREMPUAN', 'TIDAK_DIKETAHUI']) - Jenis kelamin
//      - environment: string (required, 1..30 characters) - Environment build aplikasi
//      - appVersion: string (required, 1..30 characters) - Versi rilis aplikasi klien
//      - syncedAtEpochMillis: number (required, > 0, <= request.time.toMillis() + 300000) - Waktu sinkronisasi
//      - createdAtServer: timestamp (required, == request.time) - Timestamp pencatatan server
//    Access Pattern:
//      - Read: Admin only (melindungi PII medis bayi)
//      - Create: Diizinkan jika mematuhi validasi skema ketat
//      - Update: Admin only & mematuhi validasi skema
//      - Delete: Admin only
//
// 2. Collection: baby_records/{babyDocId} (Comprehensive Baby & Mother Record)
//    Document ID: Auto-generated Firestore ID atau ID dokumen klien
//    Fields:
//      - babyIdLocal: number (required, >= 0) - ID lokal bayi pada Room SQLite
//      - motherName: string (required, 1..100 characters) - Nama lengkap/panggilan ibu
//      - motherPhoneNumber: string (required, 5..25 characters) - Nomor kontak/telepon ibu
//      - babyName: string (required, 1..100 characters) - Nama bayi
//      - birthDateEpochMillis: number (required, > 0, <= request.time.toMillis()) - Waktu kelahiran
//      - birthDateFormatted: string (required, <= 50 characters) - Tanggal lahir terformat
//      - gestationalAgeWeeks: number (required, 20..50) - Usia gestasi bayi saat lahir
//      - birthWeightGram: number (required, 100..10000) - Berat badan lahir dalam gram
//      - currentWeightGram: number (required, 100..20000) - Berat badan terkini dalam gram
//      - birthLengthCm: number (required, 0.0..100.0) - Panjang badan lahir dalam cm
//      - currentLengthCm: number (required, 0.0..100.0) - Panjang badan terkini dalam cm
//      - birthHeadCircumferenceCm: number (required, 0.0..80.0) - Lingkar kepala lahir dalam cm
//      - currentHeadCircumferenceCm: number (required, 0.0..80.0) - Lingkar kepala terkini dalam cm
//      - gender: string (required, allowed: ['LAKI_LAKI', 'PEREMPUAN', 'TIDAK_DIKETAHUI']) - Jenis kelamin
//      - environment: string (required, 1..30 characters) - Environment build aplikasi
//      - appVersion: string (required, 1..30 characters) - Versi rilis aplikasi klien
//      - syncedAtEpochMillis: number (required, > 0, <= request.time.toMillis() + 300000) - Waktu lokal sinkronisasi
//      - createdAtServer: timestamp (required, immutable, == request.time saat create) - Server timestamp pembuatan
//      - updatedAtServer: timestamp (required, == request.time) - Server timestamp pembaharuan
//    Access Pattern:
//      - Get: Diizinkan bagi klien untuk membaca dokumen tunggal dengan docId spesifik (sinkronisasi create vs update)
//      - List: Admin only (mencegah scraping/enumerasi data PII ibu & anak)
//      - Create: Diizinkan jika valid & createdAtServer == request.time & updatedAtServer == request.time
//      - Update: Diizinkan jika valid & createdAtServer tidak berubah & updatedAtServer == request.time
//      - Delete: Admin only
//
// 3. Subcollection: baby_records/{babyDocId}/pmk_sessions/{sessionId}
//    Document ID: ID dokumen sesi PMK (auto-generated atau format unik)
//    Fields:
//      - sessionIdLocal: number (required, >= 0) - ID lokal sesi PMK di SQLite
//      - startTimeEpochMillis: number (required, > 0) - Waktu mulai sesi PMK
//      - endTimeEpochMillis: number (required, >= startTimeEpochMillis) - Waktu selesai sesi PMK
//      - durationMinutes: number (required, 0..1440) - Durasi sesi dalam menit (maksimal 24 jam)
//      - caregiverRole: string (required, 1..50 characters) - Peran pelaksana PMK (Ibu, Ayah, dll)
//      - moodRating: number (required, 0..5) - Evaluasi mood/kenyamanan
//      - notes: string (required, <= 500 characters) - Catatan sesi PMK
//      - syncedAtEpochMillis: number (required, > 0, <= request.time.toMillis() + 300000) - Waktu sinkronisasi
//      - updatedAtServer: timestamp (required, == request.time) - Server timestamp pembaharuan
//    Access Pattern:
//      - Get: Diizinkan bagi klien dengan sessionId spesifik
//      - List: Admin only
//      - Create: Diizinkan jika valid & updatedAtServer == request.time
//      - Update: Diizinkan jika valid & updatedAtServer == request.time
//      - Delete: Admin only
//
// 4. Subcollection: baby_records/{babyDocId}/screenings/{screeningId}
//    Document ID: ID dokumen skrining bayi
//    Fields:
//      - screeningIdLocal: number (required, >= 0) - ID lokal skrining di SQLite
//      - screeningType: string (required, 1..50 characters) - Tipe/kategori medis skrining
//      - title: string (required, 1..100 characters) - Judul skrining
//      - categoryBadge: string (required, <= 50 characters) - Label badge kategori
//      - targetTimingLabel: string (required, <= 50 characters) - Label waktu target skrining
//      - targetDateEpoch: number (required, > 0) - Target tanggal skrining milestone 1
//      - targetDateEpoch2: number (required, >= 0) - Target tanggal skrining milestone 2 (0 jika nihil)
//      - clinicOrLab: string (required, <= 100 characters) - Klinik / lab rujukan
//      - isAlarmActive: bool (required) - Status alarm milestone 1
//      - isAlarm2Active: bool (required) - Status alarm milestone 2
//      - isCompleted: bool (required) - Status penyelesaian skrining
//      - realizationDateEpoch: number (required, >= 0) - Tanggal realisasi tindakan (0 jika belum)
//      - hospitalName: string (required, <= 100 characters) - Nama fasilitas kesehatan pelaksana
//      - doctorName: string (required, <= 100 characters) - Nama dokter/petugas medis pemeriksa
//      - clinicalResult: string (required, <= 200 characters) - Ringkasan hasil klinis
//      - findings: string (required, <= 500 characters) - Temuan pemeriksaan
//      - conclusion: string (required, <= 500 characters) - Kesimpulan / rekomendasi medis
//      - syncedAtEpochMillis: number (required, > 0, <= request.time.toMillis() + 300000) - Waktu sinkronisasi
//      - updatedAtServer: timestamp (required, == request.time) - Server timestamp pembaharuan
//    Access Pattern:
//      - Get: Diizinkan bagi klien dengan screeningId spesifik
//      - List: Admin only
//      - Create: Diizinkan jika valid & updatedAtServer == request.time
//      - Update: Diizinkan jika valid & updatedAtServer == request.time
//      - Delete: Admin only
//
// 5. Subcollection: baby_records/{babyDocId}/growth_measurements/{measurementId}
//    Document ID: ID dokumen pengukuran pertumbuhan bayi
//    Fields:
//      - measurementIdLocal: number (required, >= 0) - ID lokal pengukuran di SQLite
//      - parameter: string (required, in ['WEIGHT', 'LENGTH', 'HEAD_CIRCUMFERENCE']) - Parameter pertumbuhan
//      - value: number (required, > 0.0, <= 50000.0) - Nilai pengukuran
//      - unit: string (required, 1..10 characters) - Satuan (g, cm, dll)
//      - measurementDateEpochMillis: number (required, > 0, <= request.time.toMillis() + 300000) - Waktu pengukuran
//      - measurementDateFormatted: string (required, <= 50 characters) - Tanggal pengukuran terformat
//      - pmaWeeks: number (required, 20.0..60.0) - Postmenstrual Age dalam minggu saat pengukuran
//      - chronologicalAgeWeeks: number (required, 0..200) - Usia kronologis dalam minggu
//      - percentileBadge: string (required, <= 50 characters) - Indikasi persentil pertumbuhan
//      - note: string (required, <= 200 characters) - Catatan khusus pengukuran
//      - syncedAtEpochMillis: number (required, > 0, <= request.time.toMillis() + 300000) - Waktu sinkronisasi
//      - updatedAtServer: timestamp (required, == request.time) - Server timestamp pembaharuan
//    Access Pattern:
//      - Get: Diizinkan bagi klien dengan measurementId spesifik
//      - List: Admin only
//      - Create: Diizinkan jika valid & updatedAtServer == request.time
//      - Update: Diizinkan jika valid & updatedAtServer == request.time
//      - Delete: Admin only
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Memeriksa apakah pengguna terautentikasi di Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Memeriksa apakah pengguna memiliki hak akses Admin via Firebase Auth Custom Claims
    function isAdmin() {
      return isAuthenticated() &&
             'admin' in request.auth.token &&
             request.auth.token.admin == true;
    }

    // Memastikan dokumen hanya berisi field yang didefinisikan (mencegah schema pollution)
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Memastikan seluruh field yang didefinisikan ada dalam payload (mencegah missing field)
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Allowed Fields Schemas
    // ===============================================================

    // 1. Profil Onboarding Bayi (Backward Compatibility)
    function allowedBabyProfileFields() {
      return [
        'babyName',
        'birthDateEpochMillis',
        'birthDateFormatted',
        'gestationalAgeWeeks',
        'birthWeightGram',
        'currentWeightGram',
        'birthLengthCm',
        'currentLengthCm',
        'birthHeadCircumferenceCm',
        'currentHeadCircumferenceCm',
        'gender',
        'environment',
        'appVersion',
        'syncedAtEpochMillis',
        'createdAtServer'
      ];
    }

    // 2. Rekam Medis Komprehensif Bayi & Ibu
    function allowedBabyRecordFields() {
      return [
        'babyIdLocal',
        'motherName',
        'motherPhoneNumber',
        'babyName',
        'birthDateEpochMillis',
        'birthDateFormatted',
        'gestationalAgeWeeks',
        'birthWeightGram',
        'currentWeightGram',
        'birthLengthCm',
        'currentLengthCm',
        'birthHeadCircumferenceCm',
        'currentHeadCircumferenceCm',
        'gender',
        'environment',
        'appVersion',
        'syncedAtEpochMillis',
        'createdAtServer',
        'updatedAtServer'
      ];
    }

    // 3. Sesi PMK (Kangaroo Mother Care)
    function allowedPmkSessionFields() {
      return [
        'sessionIdLocal',
        'startTimeEpochMillis',
        'endTimeEpochMillis',
        'durationMinutes',
        'caregiverRole',
        'moodRating',
        'notes',
        'syncedAtEpochMillis',
        'updatedAtServer'
      ];
    }

    // 4. Skrining Bayi Prematur
    function allowedScreeningFields() {
      return [
        'screeningIdLocal',
        'screeningType',
        'title',
        'categoryBadge',
        'targetTimingLabel',
        'targetDateEpoch',
        'targetDateEpoch2',
        'clinicOrLab',
        'isAlarmActive',
        'isAlarm2Active',
        'isCompleted',
        'realizationDateEpoch',
        'hospitalName',
        'doctorName',
        'clinicalResult',
        'findings',
        'conclusion',
        'syncedAtEpochMillis',
        'updatedAtServer'
      ];
    }

    // 5. Pengukuran Pertumbuhan (Growth Measurements)
    function allowedGrowthMeasurementFields() {
      return [
        'measurementIdLocal',
        'parameter',
        'value',
        'unit',
        'measurementDateEpochMillis',
        'measurementDateFormatted',
        'pmaWeeks',
        'chronologicalAgeWeeks',
        'percentileBadge',
        'note',
        'syncedAtEpochMillis',
        'updatedAtServer'
      ];
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validator: Profil Onboarding Bayi
    function isValidBabyOnboardingProfile(data) {
      return hasRequiredFields(allowedBabyProfileFields()) &&
             hasOnlyAllowedFields(allowedBabyProfileFields()) &&
             
             // Identitas nama bayi (1..100 karakter, mencegah DoS / payload raksasa)
             data.babyName is string &&
             data.babyName.size() >= 1 &&
             data.babyName.size() <= 100 &&
             
             // Tanggal lahir dalam epoch milidetik (positif dan tidak boleh melebihi waktu sekarang)
             data.birthDateEpochMillis is number &&
             data.birthDateEpochMillis > 0 &&
             data.birthDateEpochMillis <= request.time.toMillis() &&
             
             // Tanggal lahir terformat (string maksimal 50 karakter)
             data.birthDateFormatted is string &&
             data.birthDateFormatted.size() <= 50 &&
             
             // Usia gestasi saat lahir (20 sampai 50 minggu)
             data.gestationalAgeWeeks is number &&
             data.gestationalAgeWeeks >= 20 &&
             data.gestationalAgeWeeks <= 50 &&
             
             // Berat lahir dan saat onboarding dalam gram (100g s.d. 10.000g / 20.000g)
             data.birthWeightGram is number &&
             data.birthWeightGram >= 100 &&
             data.birthWeightGram <= 10000 &&
             data.currentWeightGram is number &&
             data.currentWeightGram >= 100 &&
             data.currentWeightGram <= 20000 &&
             
             // Panjang badan dalam cm (0.0 jika tidak diisi, batas atas 100.0 cm)
             data.birthLengthCm is number &&
             data.birthLengthCm >= 0.0 &&
             data.birthLengthCm <= 100.0 &&
             data.currentLengthCm is number &&
             data.currentLengthCm >= 0.0 &&
             data.currentLengthCm <= 100.0 &&
             
             // Lingkar kepala dalam cm (0.0 jika tidak diisi, batas atas 80.0 cm)
             data.birthHeadCircumferenceCm is number &&
             data.birthHeadCircumferenceCm >= 0.0 &&
             data.birthHeadCircumferenceCm <= 80.0 &&
             data.currentHeadCircumferenceCm is number &&
             data.currentHeadCircumferenceCm >= 0.0 &&
             data.currentHeadCircumferenceCm <= 80.0 &&
             
             // Jenis kelamin (enum yang valid)
             data.gender is string &&
             data.gender in ['LAKI_LAKI', 'PEREMPUAN', 'TIDAK_DIKETAHUI'] &&
             
             // Metadata aplikasi & environment
             data.environment is string &&
             data.environment.size() >= 1 &&
             data.environment.size() <= 30 &&
             data.appVersion is string &&
             data.appVersion.size() >= 1 &&
             data.appVersion.size() <= 30 &&
             
             // Waktu sinkronisasi lokal (maks toleransi clock skew 5 menit di masa depan)
             data.syncedAtEpochMillis is number &&
             data.syncedAtEpochMillis > 0 &&
             data.syncedAtEpochMillis <= request.time.toMillis() + 300000 &&
             
             // Server timestamp Firestore (wajib server timestamp asli)
             data.createdAtServer is timestamp &&
             data.createdAtServer == request.time;
    }

    // Validator: Rekam Medis Komprehensif Bayi & Ibu
    function isValidBabyRecord(data) {
      return hasRequiredFields(allowedBabyRecordFields()) &&
             hasOnlyAllowedFields(allowedBabyRecordFields()) &&
             
             // ID lokal di Room database (>= 0)
             data.babyIdLocal is number &&
             data.babyIdLocal >= 0 &&
             
             // Identitas ibu (nama 1..100 karakter, no telepon 5..25 karakter)
             data.motherName is string &&
             data.motherName.size() >= 1 &&
             data.motherName.size() <= 100 &&
             data.motherPhoneNumber is string &&
             data.motherPhoneNumber.size() >= 5 &&
             data.motherPhoneNumber.size() <= 25 &&
             
             // Identitas nama bayi (1..100 karakter)
             data.babyName is string &&
             data.babyName.size() >= 1 &&
             data.babyName.size() <= 100 &&
             
             // Tanggal lahir dalam epoch milidetik (positif dan tidak boleh melebihi waktu sekarang)
             data.birthDateEpochMillis is number &&
             data.birthDateEpochMillis > 0 &&
             data.birthDateEpochMillis <= request.time.toMillis() &&
             
             // Tanggal lahir terformat (string maksimal 50 karakter)
             data.birthDateFormatted is string &&
             data.birthDateFormatted.size() <= 50 &&
             
             // Usia gestasi saat lahir (20 sampai 50 minggu)
             data.gestationalAgeWeeks is number &&
             data.gestationalAgeWeeks >= 20 &&
             data.gestationalAgeWeeks <= 50 &&
             
             // Berat lahir dan saat ini dalam gram (rentang realistis 100g s.d. 10.000g / 20.000g)
             data.birthWeightGram is number &&
             data.birthWeightGram >= 100 &&
             data.birthWeightGram <= 10000 &&
             data.currentWeightGram is number &&
             data.currentWeightGram >= 100 &&
             data.currentWeightGram <= 20000 &&
             
             // Panjang badan dalam cm (0.0 jika belum diukur, batas atas 100.0 cm)
             data.birthLengthCm is number &&
             data.birthLengthCm >= 0.0 &&
             data.birthLengthCm <= 100.0 &&
             data.currentLengthCm is number &&
             data.currentLengthCm >= 0.0 &&
             data.currentLengthCm <= 100.0 &&
             
             // Lingkar kepala dalam cm (0.0 jika belum diukur, batas atas 80.0 cm)
             data.birthHeadCircumferenceCm is number &&
             data.birthHeadCircumferenceCm >= 0.0 &&
             data.birthHeadCircumferenceCm <= 80.0 &&
             data.currentHeadCircumferenceCm is number &&
             data.currentHeadCircumferenceCm >= 0.0 &&
             data.currentHeadCircumferenceCm <= 80.0 &&
             
             // Jenis kelamin (enum yang valid)
             data.gender is string &&
             data.gender in ['LAKI_LAKI', 'PEREMPUAN', 'TIDAK_DIKETAHUI'] &&
             
             // Metadata aplikasi & environment
             data.environment is string &&
             data.environment.size() >= 1 &&
             data.environment.size() <= 30 &&
             data.appVersion is string &&
             data.appVersion.size() >= 1 &&
             data.appVersion.size() <= 30 &&
             
             // Waktu sinkronisasi lokal (maks toleransi clock skew 5 menit)
             data.syncedAtEpochMillis is number &&
             data.syncedAtEpochMillis > 0 &&
             data.syncedAtEpochMillis <= request.time.toMillis() + 300000 &&
             
             // Server timestamps
             data.createdAtServer is timestamp &&
             data.updatedAtServer is timestamp &&
             data.updatedAtServer == request.time;
    }

    // Validator: Sesi PMK
    function isValidPmkSession(data) {
      return hasRequiredFields(allowedPmkSessionFields()) &&
             hasOnlyAllowedFields(allowedPmkSessionFields()) &&
             
             // ID sesi lokal (>= 0)
             data.sessionIdLocal is number &&
             data.sessionIdLocal >= 0 &&
             
             // Waktu mulai dan selesai sesi PMK
             data.startTimeEpochMillis is number &&
             data.startTimeEpochMillis > 0 &&
             data.endTimeEpochMillis is number &&
             data.endTimeEpochMillis >= data.startTimeEpochMillis &&
             
             // Durasi sesi PMK (0 s.d. 1440 menit / 24 jam)
             data.durationMinutes is number &&
             data.durationMinutes >= 0 &&
             data.durationMinutes <= 1440 &&
             
             // Peran pengasuh (1..50 karakter)
             data.caregiverRole is string &&
             data.caregiverRole.size() >= 1 &&
             data.caregiverRole.size() <= 50 &&
             
             // Rating mood ibu/pengasuh (0..5)
             data.moodRating is number &&
             data.moodRating >= 0 &&
             data.moodRating <= 5 &&
             
             // Catatan sesi (maksimal 500 karakter)
             data.notes is string &&
             data.notes.size() <= 500 &&
             
             // Waktu sinkronisasi lokal (maks toleransi clock skew 5 menit)
             data.syncedAtEpochMillis is number &&
             data.syncedAtEpochMillis > 0 &&
             data.syncedAtEpochMillis <= request.time.toMillis() + 300000 &&
             
             // Server timestamp Firestore
             data.updatedAtServer is timestamp &&
             data.updatedAtServer == request.time;
    }

    // Validator: Skrining Bayi Prematur
    function isValidScreening(data) {
      return hasRequiredFields(allowedScreeningFields()) &&
             hasOnlyAllowedFields(allowedScreeningFields()) &&
             
             // ID screening lokal (>= 0)
             data.screeningIdLocal is number &&
             data.screeningIdLocal >= 0 &&
             
             // Tipe & judul skrining (1..50 & 1..100 karakter)
             data.screeningType is string &&
             data.screeningType.size() >= 1 &&
             data.screeningType.size() <= 50 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 100 &&
             
             // Badge kategori & label waktu target (maksimal 50 karakter)
             data.categoryBadge is string &&
             data.categoryBadge.size() <= 50 &&
             data.targetTimingLabel is string &&
             data.targetTimingLabel.size() <= 50 &&
             
             // Tanggal target skrining (targetDateEpoch > 0, targetDateEpoch2 >= 0)
             data.targetDateEpoch is number &&
             data.targetDateEpoch > 0 &&
             data.targetDateEpoch2 is number &&
             data.targetDateEpoch2 >= 0 &&
             
             // Klinik atau laboratorium (maksimal 100 karakter)
             data.clinicOrLab is string &&
             data.clinicOrLab.size() <= 100 &&
             
             // Status alarm dan penyelesaian skrining
             data.isAlarmActive is bool &&
             data.isAlarm2Active is bool &&
             data.isCompleted is bool &&
             
             // Tanggal realisasi skrining (>= 0)
             data.realizationDateEpoch is number &&
             data.realizationDateEpoch >= 0 &&
             
             // Nama fasilitas kesehatan & dokter pemeriksa (maksimal 100 karakter)
             data.hospitalName is string &&
             data.hospitalName.size() <= 100 &&
             data.doctorName is string &&
             data.doctorName.size() <= 100 &&
             
             // Hasil klinis, temuan, dan kesimpulan skrining
             data.clinicalResult is string &&
             data.clinicalResult.size() <= 200 &&
             data.findings is string &&
             data.findings.size() <= 500 &&
             data.conclusion is string &&
             data.conclusion.size() <= 500 &&
             
             // Waktu sinkronisasi lokal (maks toleransi clock skew 5 menit)
             data.syncedAtEpochMillis is number &&
             data.syncedAtEpochMillis > 0 &&
             data.syncedAtEpochMillis <= request.time.toMillis() + 300000 &&
             
             // Server timestamp Firestore
             data.updatedAtServer is timestamp &&
             data.updatedAtServer == request.time;
    }

    // Validator: Pengukuran Pertumbuhan (Growth Measurements)
    function isValidGrowthMeasurement(data) {
      return hasRequiredFields(allowedGrowthMeasurementFields()) &&
             hasOnlyAllowedFields(allowedGrowthMeasurementFields()) &&
             
             // ID pengukuran lokal (>= 0)
             data.measurementIdLocal is number &&
             data.measurementIdLocal >= 0 &&
             
             // Parameter pengukuran (enum yang valid)
             data.parameter is string &&
             data.parameter in ['WEIGHT', 'LENGTH', 'HEAD_CIRCUMFERENCE'] &&
             
             // Nilai pengukuran (> 0.0 s.d. 50000.0) dan satuan (1..10 karakter)
             data.value is number &&
             data.value > 0.0 &&
             data.value <= 50000.0 &&
             data.unit is string &&
             data.unit.size() >= 1 &&
             data.unit.size() <= 10 &&
             
             // Tanggal pengukuran epoch (> 0, toleransi clock skew 5 menit) & terformat (<= 50 karakter)
             data.measurementDateEpochMillis is number &&
             data.measurementDateEpochMillis > 0 &&
             data.measurementDateEpochMillis <= request.time.toMillis() + 300000 &&
             data.measurementDateFormatted is string &&
             data.measurementDateFormatted.size() <= 50 &&
             
             // PMA dalam minggu (20.0 s.d. 60.0) dan usia kronologis (0 s.d. 200 minggu)
             data.pmaWeeks is number &&
             data.pmaWeeks >= 20.0 &&
             data.pmaWeeks <= 60.0 &&
             data.chronologicalAgeWeeks is number &&
             data.chronologicalAgeWeeks >= 0 &&
             data.chronologicalAgeWeeks <= 200 &&
             
             // Badge persentil (<= 50 karakter) dan catatan (<= 200 karakter)
             data.percentileBadge is string &&
             data.percentileBadge.size() <= 50 &&
             data.note is string &&
             data.note.size() <= 200 &&
             
             // Waktu sinkronisasi lokal (maks toleransi clock skew 5 menit)
             data.syncedAtEpochMillis is number &&
             data.syncedAtEpochMillis > 0 &&
             data.syncedAtEpochMillis <= request.time.toMillis() + 300000 &&
             
             // Server timestamp Firestore
             data.updatedAtServer is timestamp &&
             data.updatedAtServer == request.time;
    }

    // ===============================================================
    // Rules Match Blocks
    // ===============================================================

    // Default deny all access across any unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Koleksi Profil Onboarding Bayi (Backward Compatibility)
    match /baby_onboarding_profiles/{profileId} {
      // READ: Ditutup untuk publik / anonymous guna melindungi PII medis bayi.
      // Hanya admin terverifikasi yang dapat membaca / mengekspor data.
      allow read: if isAdmin();

      // CREATE: Diizinkan untuk aplikasi klien dengan penegakan skema ketat.
      allow create: if isValidBabyOnboardingProfile(request.resource.data);

      // UPDATE: Ditolak untuk klien umum demi menjaga audit trail. Admin mematuhi validasi skema.
      allow update: if isAdmin() && isValidBabyOnboardingProfile(request.resource.data);

      // DELETE: Hanya administrator yang berhak menghapus data.
      allow delete: if isAdmin();
    }

    // 2. Koleksi Rekam Medis Komprehensif Bayi & Ibu
    match /baby_records/{babyDocId} {
      // GET: Diizinkan untuk membaca dokumen tunggal dengan docId spesifik (UUID rahasia klien).
      // Dibutuhkan klien saat sinkronisasi untuk mendeteksi create vs update dan audit timestamp.
      allow get: if true;

      // LIST: Ditutup untuk klien umum dan hanya diizinkan untuk Admin (mencegah scraping/enumerasi PII).
      allow list: if isAdmin();

      // CREATE: Diizinkan untuk aplikasi klien yang melakukan sinkronisasi dengan validasi skema ketat.
      // Server timestamps (createdAtServer & updatedAtServer) diverifikasi menggunakan request.time.
      allow create: if isValidBabyRecord(request.resource.data) &&
                       request.resource.data.createdAtServer == request.time;

      // UPDATE: Diizinkan dengan skema yang valid.
      // createdAtServer bersifat immutable (tidak boleh diubah), updatedAtServer diperbarui ke request.time.
      allow update: if isValidBabyRecord(request.resource.data) &&
                       request.resource.data.createdAtServer == resource.data.createdAtServer;

      // DELETE: Hanya administrator yang berhak menghapus rekam medis bayi.
      allow delete: if isAdmin();

      // 3. Subkoleksi Sesi PMK (Kangaroo Mother Care)
      match /pmk_sessions/{sessionId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create: if isValidPmkSession(request.resource.data);
        allow update: if isValidPmkSession(request.resource.data);
        allow delete: if isAdmin();
      }

      // 4. Subkoleksi Skrining Bayi Prematur
      match /screenings/{screeningId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create: if isValidScreening(request.resource.data);
        allow update: if isValidScreening(request.resource.data);
        allow delete: if isAdmin();
      }

      // 5. Subkoleksi Pengukuran Pertumbuhan (Growth Measurements)
      match /growth_measurements/{measurementId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create: if isValidGrowthMeasurement(request.resource.data);
        allow update: if isValidGrowthMeasurement(request.resource.data);
        allow delete: if isAdmin();
      }
    }
  }
}
